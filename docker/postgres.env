## Change these parameters to your needs
TZ=Europe/Vienna
POSTGRES_USER=wt
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wt

## Additional (optional) parameters
# - WT_BIND=[::]:8080
# - WT_LOGGING=true
# - WT_DEBUG=true
# - WT_REGISTRATION_DISABLED=true
# - WT_SOCIALS_DISABLED=true
# - WT_REGISTRATION_DISABLED=true
# - WT_SOCIALS_DISABLED=true
# - WT_JWT_ENCRYPTION_KEY=my-secret-key
# - WT_HAMMERHEAD_CLIENT_ID=
# - WT_HAMMERHEAD_CLIENT_SECRET=
# - WT_HAMMERHEAD_REDIRECT_URI=
# - WT_HAMMERHEAD_WEBHOOK_SECRET=
# - WT_VAPID_PUBLIC_KEY
# - WT_VAPID_PRIVATE_KEY
# - WT_MAILJET_PUBLIC_KEY
# - WT_MAILJET_PRIVATE_KEY
# - WT_MAIL_SENDER_NAME
# - WT_MAIL_SENDER_ADDRESS
# - WT_SMTP_HOST
# - WT_ADMIN_EMAIL
# - WT_LEGAL_NOTICE_PATH
# - WT_PRIVACY_PATH

## Only change these parameters if you know what you are doing
PGUSER=$POSTGRES_USER
WT_DATABASE_DRIVER=postgres
WT_DSN=host=db user=$POSTGRES_USER password=$POSTGRES_PASSWORD dbname=$POSTGRES_DB port=5432 sslmode=disable TimeZone=$TZ
