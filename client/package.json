{
  "name": "client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host=0.0.0.0",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "cleanup": "npm run lint -- --fix && npm run format",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "extract-translations": "ngx-translate-extract --input ./src --output ./src/assets/i18n/en.po --format pot --sort --clean",
    "generate-workout-types": "node scripts/generate-workout-types.js && npm run cleanup"
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/localize": "~22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/router": "^22.1.3",
    "@angular/service-worker": "^22.1.3",
    "@maplibre/ngx-maplibre-gl": "^22.1.0",
    "@ng-bootstrap/ng-bootstrap": "^21.0.0",
    "@ng-icons/core": "^35.0.1",
    "@ng-icons/font-awesome": "^35.0.1",
    "@ng-icons/heroicons": "^35.0.1",
    "@ng-icons/ionicons": "^35.0.1",
    "@ng-icons/material-icons": "^35.0.1",
    "@ng-icons/material-symbols": "^35.0.1",
    "@ng-icons/octicons": "^35.0.1",
    "@ng-icons/simple-icons": "^35.0.1",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@popperjs/core": "^2.11.8",
    "angular-calendar": "^0.32.2",
    "bootstrap": "^5.3.8",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chartjs-plugin-zoom": "^2.2.0",
    "date-fns": "^4.4.0",
    "maplibre-gl": "^6.5.0",
    "maplibre-theme": "^1.0.0",
    "ngx-translate-lint": "^1.27.5",
    "pofile": "^1.1.4",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.0.8",
    "@types/jasmine": "~6.0.0",
    "@vendure/ngx-translate-extract": "^10.2.0",
    "angular-eslint": "22.2.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jasmine-core": "~6.3.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.67.0",
    "yaml": "^2.9.0"
  },
  "browser": {
    "fs": false
  }
}
